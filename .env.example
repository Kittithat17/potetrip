# backend
PORT=8081
DATABASE_URL=postgres://travel:travel@localhost:5440/travel?sslmode=disable
# gemini | mock (ผลตัวอย่าง ใช้ลองหน้าจอตอน dev โดยไม่ต้องมี key) | none
SLIP_PROVIDER=gemini
GEMINI_API_KEY=
# ชื่อรุ่นตามที่ Google AI Studio แสดงว่าใช้ free tier ได้ เช่นรุ่น Flash หรือ Flash-Lite
GEMINI_MODEL=
SLIP_CONCURRENCY=3
CORS_ORIGINS=http://localhost:5173

# การเข้าสู่ระบบ: google (ของจริง) | mock (dev เท่านั้น พิมพ์ชื่อแล้วเข้าได้เลย ใช้กับ https ไม่ได้)
AUTH_PROVIDER=mock
# จาก Google Cloud Console > Clients (ประเภท Web application) ห้าม commit ค่า secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL ที่ผู้ใช้เปิดแอป (ไม่มี path) redirect URI ที่ต้องลงทะเบียนใน Google คือ
# {PUBLIC_URL}/api/v1/auth/google/callback  และถ้าเป็น https คุกกี้จะเป็น Secure อัตโนมัติ
PUBLIC_URL=http://localhost:5173
# อัตราแลกเปลี่ยน (ไม่ต้องใช้ key) ค่าเริ่มต้นคือ https://api.frankfurter.dev/v1
# FX_BASE_URL=

# frontend
# dev: /api/v1 (Vite proxies to the backend) / production: full backend URL
VITE_API_BASE_URL=/api/v1
